# === Buzón de ingesta (Gmail dedicado) ===
# Dirección del buzón que recibe los reenvíos de Bancolombia
IMAP_USER=<direccion-del-buzon-de-ingesta>
# Contraseña de aplicación de Gmail (requiere 2FA activo). NO es la contraseña normal.
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Solo para los scripts de migración: dirección desde la que se enviaron los
# .eml adjuntos (scripts/migrar-adjuntos.ts, migrar-uber.ts, inspeccionar-adjuntos.ts)
MIGRACION_REMITENTE=<correo-que-envio-los-adjuntos>

# ID del usuario/cliente dueño de estos movimientos (uuid de Supabase Auth)
CUENTAS_USER_ID=

# === Supabase ===
# Usadas por el ingestor (rol de servicio) y por la web (clave anónima)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
